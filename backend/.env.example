# Flask Configuration
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=True

# Secret Key (generate a new one for production)
SECRET_KEY=your-super-secret-key-change-in-production

# JWT Configuration
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production
JWT_ACCESS_TOKEN_EXPIRES=3600

# n8n Webhooks
N8N_BASE_URL=https://your-instance.n8n.cloud
N8N_CONTACT_WEBHOOK=https://robert-gleim.app.n8n.cloud/webhook-test/contact-form
N8N_NEWSLETTER_WEBHOOK=

# Admin Credentials (change these!)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Store Configuration
STORE_EMAIL=customerservice@nothingelsesolutions.com

# Frontend URL (for CORS)
# For production, set this to your Vercel URL:
# FRONTEND_URL=https://your-app.vercel.app
FRONTEND_URL=http://localhost:3000

# Contact submissions are stored in the database and managed from admin dashboard
